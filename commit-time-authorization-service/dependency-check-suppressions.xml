<?xml version="1.0" encoding="UTF-8"?>
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">
    <!--
      Spring Framework 6.2.19 is the newest 6.2 release, and Spring Boot 3.5.16 (the newest 3.5)
      manages that version. The patched line is 6.2.20 / 7.0.8.1, which is not published on the
      6.2 line this service builds against. None of these CVSS 9 issues are on a path this API uses:
      no view resolver, no /** view mapping, no WebFlux, no SSE, no functional endpoints, and no
      application SpEL compiler. Re-evaluate when a Spring Boot 3.5 build picks up 6.2.20 or later.
    -->
    <suppress>
        <notes>CVE-2026-47884: XsltView SSRF/RCE. This service does not render views.</notes>
        <packageUrl regex="true">^pkg:maven/org\.springframework/spring-[^/]+@6\.2\..*$</packageUrl>
        <cve>CVE-2026-47884</cve>
    </suppress>
    <suppress>
        <notes>CVE-2026-47890: SSE view-fragment stream corruption. This service does not use SSE.</notes>
        <packageUrl regex="true">^pkg:maven/org\.springframework/spring-[^/]+@6\.2\..*$</packageUrl>
        <cve>CVE-2026-47890</cve>
    </suppress>
    <suppress>
        <notes>CVE-2026-47891: WebFlux XML memory limit. This service is Spring MVC, not WebFlux.</notes>
        <packageUrl regex="true">^pkg:maven/org\.springframework/spring-[^/]+@6\.2\..*$</packageUrl>
        <cve>CVE-2026-47891</cve>
    </suppress>
    <suppress>
        <notes>CVE-2026-47892: WebFlux functional pre-flight bypass. This service is Spring MVC.</notes>
        <packageUrl regex="true">^pkg:maven/org\.springframework/spring-[^/]+@6\.2\..*$</packageUrl>
        <cve>CVE-2026-47892</cve>
    </suppress>
    <suppress>
        <notes>CVE-2026-59313: MVC functional SSE corruption. This service does not use functional endpoints or SSE.</notes>
        <packageUrl regex="true">^pkg:maven/org\.springframework/spring-[^/]+@6\.2\..*$</packageUrl>
        <cve>CVE-2026-59313</cve>
    </suppress>
    <suppress>
        <notes>CVE-2026-59283: SpEL compiler safety-guard bypass. This service does not compile untrusted SpEL.</notes>
        <packageUrl regex="true">^pkg:maven/org\.springframework/spring-[^/]+@6\.2\..*$</packageUrl>
        <cve>CVE-2026-59283</cve>
    </suppress>
</suppressions>
